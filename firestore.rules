rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // HELPERS
    // ═══════════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(uid()));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return isSignedIn()
             && userExists()
             && userData().role == 'admin';
    }

    function isMerchant() {
      return isSignedIn()
             && userExists()
             && userData().role == 'merchant';
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ═══════════════════════════════════════════════════════════
    // USERS + FAVORITES (subcollection)
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {

      // ─── User document ───
      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelf(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.status == 'active';

      allow update: if isSelf(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.status == resource.data.status;

      allow update, delete: if isAdmin();

      // ─── Favorites subcollection ───
      // Path: users/{userId}/favorites/{placeId}
      match /favorites/{placeId} {

        allow read: if isSelf(userId);

        allow create: if isSelf(userId)
                      && request.resource.data.placeId == placeId;

        allow delete: if isSelf(userId);

        allow update: if false;  // لا تعديل
      }
    }

    // ═══════════════════════════════════════════════════════════
    // PLACES
    // ═══════════════════════════════════════════════════════════
    match /places/{placeId} {

      allow read: if (resource.data.isApproved == true
                      && resource.data.isActive == true)
                  || (isSignedIn() && (
                       resource.data.ownerId == uid() || isAdmin()
                     ));

      allow create: if isSignedIn()
                    && (isMerchant() || isAdmin())
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.isApproved == false;

      allow update: if isSignedIn()
                    && (
                      (resource.data.ownerId == uid()
                       && request.resource.data.isApproved
                          == resource.data.isApproved)
                      || isAdmin()
                    );

      allow delete: if isAdmin();

      // ─── Reviews subcollection (مستقبلًا) ───
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.userId == uid();
        allow update, delete: if isSignedIn()
                              && (resource.data.userId == uid() || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CATEGORIES
    // ═══════════════════════════════════════════════════════════
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // REVIEWS (top-level — احتياطيًا)
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid();
      allow update, delete: if isSignedIn()
                            && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // MERCHANTS (Phase 2)
    // ═══════════════════════════════════════════════════════════
    match /merchants/{merchantId} {
      allow read: if isSignedIn()
                  && (merchantId == uid() || isAdmin());
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT: رفض
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}