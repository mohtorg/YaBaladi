rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YaBaladi Firestore Security Rules
// [v3.1-TEMP — 2026-10-18] — OPEN WRITE FOR SEEDING (DEV ONLY)
// ⚠️ WARNING: Revert to v3.0 immediately after seeding!
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userExists() { return exists(/databases/$(database)/documents/users/$(uid())); }
    function userData() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    
    function isAdmin() {
      return isSignedIn() && userExists() && userData().role == 'admin';
    }
    function isMerchant() {
      return isSignedIn() && userExists() && userData().role == 'merchant';
    }
    function isSelf(userId) { return isSignedIn() && uid() == userId; }
    
    function isString(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }
    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }
    function authEmail() { return request.auth.token.email; }

    function isValidTripStatus(s) { return s in ['draft', 'active', 'completed', 'cancelled']; }
    function isValidTransportMode(m) { return m in ['walking', 'driving', 'transit']; }
    function isValidDurationType(d) { return d in ['half_day', 'full_day', 'weekend']; }
    function isValidStatusTransition(from, to) {
      return (from == 'draft' && to in ['active', 'cancelled'])
          || (from == 'active' && to in ['completed', 'cancelled'])
          || from == to;
    }
    function isValidStopsCount(n) { return n is int && n >= 0 && n <= 50; }

    // ─── USERS (Strict) ───
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.uid == userId
                    && (!('status' in request.resource.data) || request.resource.data.status == 'active');
      allow update: if isSelf(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid
                    && (!('email' in request.resource.data) || request.resource.data.email == authEmail())
                    && (!('status' in request.resource.data) || !('status' in resource.data) || request.resource.data.status == resource.data.status)
                    && (!('name' in request.resource.data) || isString(request.resource.data.name, 2, 50));
      allow delete: if isSelf(userId) || isAdmin();

      match /favorites/{placeId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && request.resource.data.placeId == placeId;
        allow delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // ─── FAVORITES (Strict) ───
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // ⚠️ PLACES — TEMPORARILY OPENED FOR SEEDING (DEV ONLY) ⚠️
    // ═══════════════════════════════════════════════════════════
    match /places/{placeId} {
      allow read, write: if true; // ⚠️ ثغرة مؤقتة (لا تتطلب تسجيل دخول)

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == uid() && isValidRating(request.resource.data.rating) && isString(request.resource.data.comment, 1, 1000);
        allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin()) && isValidRating(request.resource.data.rating) && isString(request.resource.data.comment, 1, 1000);
        allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════
    // ⚠️ CATEGORIES — TEMPORARILY OPENED FOR SEEDING (DEV ONLY) ⚠️
    // ═══════════════════════════════════════════════════════════
    match /categories/{categoryId} {
      allow read, write: if true; // ⚠️ ثغرة مؤقتة
    }

    // ─── REVIEWS TOP LEVEL (Strict) ───
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == uid() && isValidRating(request.resource.data.rating) && isString(request.resource.data.comment, 1, 1000);
      allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin()) && isValidRating(request.resource.data.rating) && isString(request.resource.data.comment, 1, 1000);
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ─── MERCHANTS (Strict) ───
    match /merchants/{merchantId} {
      allow read: if isSignedIn() && (merchantId == uid() || isAdmin());
      allow write: if isAdmin();
    }

    // ─── VISIT REQUESTS (Strict) ───
    match /visit_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid() && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == uid() && resource.data.status == 'pending' && request.resource.data.status == 'cancelled');
      allow delete: if isSignedIn() && ((resource.data.userId == uid() && resource.data.status == 'pending') || isAdmin());
    }

    // ─── TRIP PLANS (Strict) ───
    match /trip_plans/{planId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.keys().hasAll(['userId', 'title', 'governorateId', 'governorateNameAr', 'transportMode', 'durationType', 'status', 'stops', 'totalDistanceKm', 'totalDurationMin', 'createdAt', 'updatedAt'])
                    && isString(request.resource.data.title, 1, 100)
                    && isValidTransportMode(request.resource.data.transportMode)
                    && isValidDurationType(request.resource.data.durationType)
                    && request.resource.data.status in ['draft', 'active']
                    && request.resource.data.stops is list && isValidStopsCount(request.resource.data.stops.size())
                    && request.resource.data.totalDistanceKm is number && request.resource.data.totalDistanceKm >= 0
                    && request.resource.data.totalDurationMin is int && request.resource.data.totalDurationMin >= 0
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn()
                    && resource.data.userId == uid()
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.governorateId == resource.data.governorateId
                    && request.resource.data.governorateNameAr == resource.data.governorateNameAr
                    && request.resource.data.createdAt == resource.data.createdAt
                    && isValidTripStatus(request.resource.data.status)
                    && isValidStatusTransition(resource.data.status, request.resource.data.status)
                    && isString(request.resource.data.title, 1, 100)
                    && request.resource.data.stops is list && isValidStopsCount(request.resource.data.stops.size())
                    && request.resource.data.totalDistanceKm is number && request.resource.data.totalDistanceKm >= 0
                    && request.resource.data.totalDurationMin is int && request.resource.data.totalDurationMin >= 0
                    && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ─── DEFAULT DENY ALL ───
    match /{document=**} {
      allow read, write: if false;
    }
  }
}