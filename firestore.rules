rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YaBaladi Firestore Security Rules
//
// [v2.4 — 2026-10-16] — Wave 1a SEC: trip_plans hardening
//   - HARDEN: trip_plans read → owner only (Admin excluded)
//   - HARDEN: trip_plans update → status transitions + immutable fields
//   - HARDEN: create → full field validation + status enum
//   - HARDEN: updatedAt must equal request.time
//   - ADD: isValidTripStatus, isValidTransportMode, isValidDurationType
//   - ADD: isValidStatusTransition, isValidStopsCount
//   - NOTE: Admin access for moderation → separate /admin/trips (Wave 2)
//
// [v2.3 — 2026-10-15] — FIX CRITICAL: places read was blocking queries
// [v2.2 — 2026-10-15] — trip_plans initial rules
// [v2.1 — 2026-10-14] — reviews validation fix
// [v2.0 — 2026-10-14] — visit_requests
// [v1.1 — 2026-10-13] — users delete
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════
    // HELPERS — العامة
    // ═══════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(uid()));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return isSignedIn()
             && userExists()
             && userData().role == 'admin';
    }

    function isMerchant() {
      return isSignedIn()
             && userExists()
             && userData().role == 'merchant';
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isString(field, minLen, maxLen) {
      return field is string
          && field.size() >= minLen
          && field.size() <= maxLen;
    }

    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function noQrFieldsOnCreate() {
      return (
        !('isVerified' in request.resource.data)
        || request.resource.data.isVerified == false
      )
      && !('visitId' in request.resource.data)
      && !('verifiedAt' in request.resource.data);
    }

    function noQrUpgrade() {
      return !('isVerified' in request.resource.data)
             || request.resource.data.isVerified
                == resource.data.isVerified;
    }

    // ═══════════════════════════════════════════════════════════
    // HELPERS — Trips
    // ═══════════════════════════════════════════════════════════

    function isValidTripStatus(s) {
      return s in ['draft', 'active', 'completed', 'cancelled'];
    }

    function isValidTransportMode(m) {
      return m in ['walking', 'driving', 'transit'];
    }

    function isValidDurationType(d) {
      return d in ['half_day', 'full_day', 'weekend'];
    }

    function isValidStatusTransition(from, to) {
      return (from == 'draft'    && to in ['active', 'cancelled'])
          || (from == 'active'   && to in ['completed', 'cancelled'])
          || from == to;
    }

    function isValidStopsCount(n) {
      return n is int && n >= 0 && n <= 50;
    }

    // ═══════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {

      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelf(userId)
                    && request.resource.data.role == 'user'
                    && request.resource.data.uid == userId
                    && (
                      !('status' in request.resource.data)
                      || request.resource.data.status == 'active'
                    );

      allow update: if isSelf(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid
                    && (
                      !('email' in request.resource.data)
                      || request.resource.data.email == authEmail()
                    )
                    && (
                      !('status' in request.resource.data)
                      || !('status' in resource.data)
                      || request.resource.data.status == resource.data.status
                    );

      allow delete: if isSelf(userId) || isAdmin();

      match /favorites/{placeId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId)
                      && request.resource.data.placeId == placeId;
        allow delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════
    // FAVORITES (top-level)
    // ═══════════════════════════════════════════════════════════
    match /favorites/{favoriteId} {

      allow read: if isSignedIn()
                  && (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn()
                    && request.resource.data.userId == uid();

      allow delete: if isSignedIn()
                    && (resource.data.userId == uid() || isAdmin());

      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PLACES
    // ═══════════════════════════════════════════════════════════
    match /places/{placeId} {

      allow read: if true;

      allow create: if isSignedIn()
                    && (isMerchant() || isAdmin())
                    && request.resource.data.ownerId == uid()
                    && request.resource.data.isApproved == false
                    && request.resource.data.isActive == true
                    && isString(request.resource.data.nameAr, 2, 100)
                    && isString(request.resource.data.nameEn, 2, 100);

      allow update: if isSignedIn()
                    && (
                      (resource.data.ownerId == uid()
                       && request.resource.data.isApproved
                          == resource.data.isApproved
                       && request.resource.data.ownerId
                          == resource.data.ownerId)
                      || isAdmin()
                    );

      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if isSignedIn()
                      && request.resource.data.userId == uid()
                      && isValidRating(request.resource.data.rating)
                      && isString(request.resource.data.comment, 1, 1000)
                      && noQrFieldsOnCreate();

        allow update: if isSignedIn()
                      && (resource.data.userId == uid() || isAdmin())
                      && noQrUpgrade();

        allow delete: if isSignedIn()
                      && (resource.data.userId == uid() || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CATEGORIES
    // ═══════════════════════════════════════════════════════════
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // REVIEWS (top-level)
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && isValidRating(request.resource.data.rating)
                    && isString(request.resource.data.comment, 1, 1000)
                    && noQrFieldsOnCreate();

      allow update: if isSignedIn()
                    && (resource.data.userId == uid() || isAdmin())
                    && noQrUpgrade();

      allow delete: if isSignedIn()
                    && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // MERCHANTS
    // ═══════════════════════════════════════════════════════════
    match /merchants/{merchantId} {
      allow read: if isSignedIn()
                  && (merchantId == uid() || isAdmin());
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // VISIT REQUESTS
    // ═══════════════════════════════════════════════════════════
    match /visit_requests/{requestId} {

      allow read: if isSignedIn()
                  && (resource.data.userId == uid() || isAdmin());

      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.userId == uid()
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled');

      allow delete: if isSignedIn()
                    && (
                      (resource.data.userId == uid()
                       && resource.data.status == 'pending')
                      || isAdmin()
                    );
    }

    // ═══════════════════════════════════════════════════════════
    // TRIP PLANS — Hardened
    // ═══════════════════════════════════════════════════════════
    match /trip_plans/{planId} {

      allow read: if isSignedIn()
                  && resource.data.userId == uid();

      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.keys().hasAll([
                         'userId', 'title',
                         'governorateId', 'governorateNameAr',
                         'transportMode', 'durationType',
                         'status', 'stops',
                         'totalDistanceKm', 'totalDurationMin',
                         'createdAt', 'updatedAt'
                       ])
                    && isString(request.resource.data.title, 1, 100)
                    && isValidTransportMode(
                         request.resource.data.transportMode
                       )
                    && isValidDurationType(
                         request.resource.data.durationType
                       )
                    && request.resource.data.status in ['draft', 'active']
                    && request.resource.data.stops is list
                    && isValidStopsCount(request.resource.data.stops.size())
                    && request.resource.data.totalDistanceKm is number
                    && request.resource.data.totalDistanceKm >= 0
                    && request.resource.data.totalDurationMin is int
                    && request.resource.data.totalDurationMin >= 0
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if isSignedIn()
                    && resource.data.userId == uid()
                    && request.resource.data.userId
                       == resource.data.userId
                    && request.resource.data.governorateId
                       == resource.data.governorateId
                    && request.resource.data.governorateNameAr
                       == resource.data.governorateNameAr
                    && request.resource.data.createdAt
                       == resource.data.createdAt
                    && isValidTripStatus(request.resource.data.status)
                    && isValidStatusTransition(
                         resource.data.status,
                         request.resource.data.status
                       )
                    && isString(request.resource.data.title, 1, 100)
                    && request.resource.data.stops is list
                    && isValidStopsCount(
                         request.resource.data.stops.size()
                       )
                    && request.resource.data.totalDistanceKm is number
                    && request.resource.data.totalDistanceKm >= 0
                    && request.resource.data.totalDurationMin is int
                    && request.resource.data.totalDurationMin >= 0
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn()
                    && resource.data.userId == uid();
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT: DENY ALL
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}