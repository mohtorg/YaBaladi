rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YaBaladi Firestore Security Rules
// [v5.9 — 2026-10-29] — Wave 17: DISTRICTS (subcollection) for governorates
//   - ADD: /governorates/{govId}/districts/{districtId}
//     • read: public (any user needs to see neighborhoods)
//     • write: admin only
//   - KEPT: all v5.8 rules intact.
// [v5.8 — 2026-10-29] — SECURITY FIX: prevent self role escalation
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ───
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(uid()));
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isAdmin() {
      return isSignedIn() && userExists() && userData().role == 'admin';
    }
    function isMerchant() {
      return isSignedIn() && userExists() && userData().role == 'merchant';
    }
    function isModerator() {
      return isSignedIn() && userExists() && userData().role == 'moderator';
    }
    function isModeratorOrAdmin() {
      return isAdmin() || isModerator();
    }
    function isSelf(userId) { return isSignedIn() && uid() == userId; }

    function isString(field, minLen, maxLen) {
      return field is string
          && field.size() >= minLen
          && field.size() <= maxLen;
    }
    function isValidRating(rating) {
      return rating is number && rating >= 1 && rating <= 5;
    }
    function authEmail() { return request.auth.token.email; }

    // ─── Trip helpers ───
    function isValidTripStatus(s) {
      return s in ['draft', 'active', 'completed', 'cancelled'];
    }
    function isValidTransportMode(m) {
      return m in ['walking', 'driving', 'transit', 'car'];
    }
    function isValidDurationType(d) {
      return d in ['half_day', 'full_day', 'weekend'];
    }
    function isValidStopsCount(n) { return n is int && n >= 0 && n <= 50; }

    // ─── Categories helpers ───
    function isValidSlug(s) {
      return isString(s, 2, 50) && s.matches('^[a-z0-9_]+$');
    }
    function isValidHexColor(c) {
      return c is string && c.size() == 7 && c.matches('^#[0-9A-Fa-f]+$');
    }

    // ─── Filters helpers ───
    function isValidFilterSlug(s) {
      return isString(s, 2, 50) && s.matches('^[a-z0-9_]+$');
    }
    function isValidFilterData(data) {
      return data.keys().hasAll(['nameAr', 'nameEn', 'type', 'fieldKey', 'options'])
          && isString(data.nameAr, 1, 100)
          && isString(data.nameEn, 1, 100)
          && data.type in ['single_choice', 'multi_choice', 'range', 'boolean', 'sort']
          && isString(data.fieldKey, 1, 50)
          && data.options is list
          && data.options.size() <= 50;
    }

    // ─── Ownership helpers ───
    function isMerchantOwner(placeId) {
      return isMerchant() && (
        get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == uid()
      );
    }
    function isPlaceOwner(placeId) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/places/$(placeId))
          && get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == uid();
    }

    // ═══════════════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelf(userId)
                    && request.resource.data.role == 'user';

      allow update: if isAdmin() || (
        isSelf(userId) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny([
            'role',
            'createdAt',
            'email',
            'isVerified',
            'isBanned',
            'banReason',
            'bannedAt'
          ])
      );

      allow delete: if isSelf(userId) || isAdmin();

      match /favorites/{placeId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId);
        allow delete: if isSelf(userId);
        allow update: if false;
      }
    }

    // ─── FAVORITES (Top-level mirror) ───
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update: if false;
    }

    // ═══════════════════════════════════════════════════════════
    // PLACES
    // ═══════════════════════════════════════════════════════════
    match /places/{placeId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isMerchantOwner(placeId) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['ownerId', 'isApproved', 'averageRating', 'reviewCount', 'createdAt'])
      );

      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow get: if true;
        allow list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == uid();
        allow update, delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      }
    }

    // ═══════════════════════════════════════════════════════════
    // CATEGORIES
    // ═══════════════════════════════════════════════════════════
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // GOVERNORATES + DISTRICTS (Wave 17)
    // ═══════════════════════════════════════════════════════════
    match /governorates/{governorateId} {
      allow read: if true;
      allow write: if isAdmin();

      // ✅ [v5.9] الأحياء داخل المحافظة
      match /districts/{districtId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════════
    // FILTERS
    // ═══════════════════════════════════════════════════════════
    match /filters/{filterId} {
      allow read: if true;
      allow write: if isModeratorOrAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // REVIEWS (Top-level mirror)
    // ═══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // MERCHANT REQUESTS
    // ═══════════════════════════════════════════════════════════
    match /merchant_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // OFFERS
    // ═══════════════════════════════════════════════════════════
    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (isAdmin() || isPlaceOwner(request.resource.data.placeId));
      allow update, delete: if isAdmin() || (isSignedIn() && isPlaceOwner(resource.data.placeId));
    }

    // ═══════════════════════════════════════════════════════════
    // ADMIN STATS
    // ═══════════════════════════════════════════════════════════
    match /admin_stats/{docId} {
      allow read: if isModeratorOrAdmin();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // VISIT REQUESTS
    // ═══════════════════════════════════════════════════════════
    match /visit_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // TRIP PLANS
    // ═══════════════════════════════════════════════════════════
    match /trip_plans/{planId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && isValidTripStatus(request.resource.data.status);

      allow read: if isSignedIn()
                  && (resource.data.userId == uid() || isAdmin());

      allow update: if isSignedIn()
                    && (resource.data.userId == uid() || isAdmin())
                    && isValidTripStatus(request.resource.data.status);

      allow delete: if isSignedIn()
                    && (resource.data.userId == uid() || isAdmin());
    }

    // ═══════════════════════════════════════════════════════════
    // SUPPORT TICKETS
    // ═══════════════════════════════════════════════════════════
    match /support_tickets/{ticketId} {
      allow create: if (
          (request.auth != null && request.resource.data.userId == request.auth.uid) ||
          (request.auth == null && request.resource.data.userId == 'anonymous')
        ) && request.resource.data.status == 'open';

      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == uid());

      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // NOTIFICATIONS
    // ═══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == uid();

      allow create: if isAdmin();

      allow update: if isSignedIn()
                    && resource.data.userId == uid()
                    && !request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasAny(['userId', 'title', 'body', 'type', 'createdAt']);

      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ═══════════════════════════════════════════════════════════
    // SETTINGS
    // ═══════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════
    // DEFAULT DENY ALL
    // ═══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}