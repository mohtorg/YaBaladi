rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// YaBaladi Firestore Security Rules
// [v7.1 — 2026-11-19] — تقييم واحد لكل مستخدم/مكان بمعرّف حتمي، وحدود حجم للنصوص.
// [v7.0 — 2026-11-18] — SECURITY HARDENING (الجولة 1 / حزم P0-أ إلى P0-د)
//   - places: منع إنشاء مكان معتمد مسبقاً، وزيادة viewCount بمقدار 1 لمسجّل فقط،
//             وحصر كتابة حقول التقييم المشتقة في نطاقات صالحة وبخطوة واحدة.
//   - users:  قيم ابتدائية ثابتة عند الإنشاء، حماية حقول الثقة والتوثيق والاشتراك،
//             منع حذف مستند المحظور (لا تهرّب من الحظر)، قاعدة fcm_tokens.
//   - ADDED: owner_claim_requests / moderation_logs / rating_revisions / system_events.
//   - audit_logs: إضافة فقط؛ التحديث مقصور على أعلام الأرشفة والحذف الناعم؛ لا حذف نهائي.
//   - notifications: الإنشاء للمشرف/الأدمن فقط.
//   - ratings: قيم ابتدائية ثابتة، وتعديل المالك لتقييمه دون المساس بحقول الإشراف.
//   - حدّ معروف: كتابة المتوسطات من العميل مقيّدة بنطاق وخطوة فقط، والحل الجذري
//     نقلها إلى الخادم (حزمة P1، تتطلب قراراً بشأن خطة Blaze).
// [v6.1 — 2026-11-12] — FIX: Added rule for /review_criteria
//   - ADDED: /review_criteria/{criterionId} — read public; write admin only.
//   - Fixes PERMISSION_DENIED error when loading review criteria in the app.
// [v6.0 — 2026-11-12] — CRITICAL: Added rating pipeline collections.
//   - ADDED: /visits/{visitId}          — read owner/admin; create owner; delete admin.
//   - ADDED: /ratings/{ratingId}        — read published or owner/moderator; create owner;
//                                          update restricted to helpfulCount/reportCount +1;
//                                          delete admin only.
//   - ADDED: /place_aggregates/{placeId}— read public; create/update signed-in;
//                                          delete admin only.
//   - ADDED: /reports/{reportId}        — create signed-in reporter; read/update admin/mod.
//   - DOCUMENTED: /zones supports `notes` (string) and `geoZoneId` (string)
//                 via permissive admin write. No schema validation added — avoids
//                 breaking existing data during migration.
//   - Preserved: all v5.23 rules (users/places/districts/zones/governorates/etc.).
//   - Preserved: catch-all deny at the bottom.
// [v5.23 — 2026-11-11] — FIXED: Added root-level rules for districts and zones.
// [v5.22 — 2026-11-09] — FIXED: Favorites (verified) + Notifications (preemptive fix).
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── دوال مساعدة أساسية ───
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userExists() { return exists(/databases/$(database)/documents/users/$(uid())); }
    function userData() { return get(/databases/$(database)/documents/users/$(uid())).data; }

    function isAdmin() { return isSignedIn() && userExists() && userData().role == 'admin'; }
    function isMerchant() { return isSignedIn() && userExists() && userData().role == 'merchant'; }
    function isModerator() { return isSignedIn() && userExists() && userData().role == 'moderator'; }
    function isModeratorOrAdmin() { return isAdmin() || isModerator(); }
    function isSelf(userId) { return isSignedIn() && uid() == userId; }

    // ─── دوال التحقق من الصحة (Validation) ───
    function isString(field, minLen, maxLen) { return field is string && field.size() >= minLen && field.size() <= maxLen; }
    function isValidRating(rating) { return rating is number && rating >= 1 && rating <= 5; }
    function authEmail() { return request.auth.token.email; }

    function isValidTripStatus(s) { return s in ['draft', 'active', 'completed', 'cancelled']; }
    function isValidTransportMode(m) { return m in ['walking', 'driving', 'transit', 'car']; }
    function isValidDurationType(d) { return d in ['halfDay', 'fullDay', 'weekend']; }
    function isValidStopsCount(n) { return n is int && n >= 0 && n <= 50; }

    function isValidSlug(s) { return isString(s, 2, 50) && s.matches('^[a-z0-9_]+$'); }
    function isValidHexColor(c) { return c is string && c.size() == 7 && c.matches('^#[0-9A-Fa-f]+$'); }

    function isValidFilterSlug(s) { return isString(s, 2, 50) && s.matches('^[a-z0-9_]+$'); }
    function isValidFilterData(data) { return data.keys().hasAll(['nameAr', 'nameEn', 'type', 'fieldKey', 'options']) && isString(data.nameAr, 1, 100) && isString(data.nameEn, 1, 100) && data.type in ['single_choice', 'multi_choice', 'range', 'boolean', 'sort'] && isString(data.fieldKey, 1, 50) && data.options is list && data.options.size() <= 50; }

    function isMerchantOwner(placeId) { 
      return isMerchant() && get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == uid(); 
    }
    function isPlaceOwner(placeId) { 
      return isSignedIn() && exists(/databases/$(database)/documents/places/$(placeId)) && get(/databases/$(database)/documents/places/$(placeId)).data.ownerId == uid(); 
    }

    // تحديث حقول التقييم المشتقة على المكان (يكتبها AggregateService من العميل مؤقتاً).
    function isValidDerivedPlaceUpdate(oldD, newD) {
      return newD.diff(oldD).affectedKeys().hasOnly(['averageRating', 'reviewCount', 'adjustedScore', 'sampleQuality', 'isRankable'])
          && newD.get('averageRating', 0) is number && newD.get('averageRating', 0) >= 0 && newD.get('averageRating', 0) <= 5
          && newD.get('reviewCount', 0) is int && newD.get('reviewCount', 0) >= 0
          && newD.get('reviewCount', 0) - oldD.get('reviewCount', 0) <= 1
          && oldD.get('reviewCount', 0) - newD.get('reviewCount', 0) <= 1
          && newD.get('adjustedScore', 0) is number && newD.get('adjustedScore', 0) >= 0 && newD.get('adjustedScore', 0) <= 5
          && newD.get('sampleQuality', 0) is number && newD.get('sampleQuality', 0) >= 0 && newD.get('sampleQuality', 0) <= 1
          && newD.get('isRankable', false) is bool;
    }

    // ─── المستخدمون (Users) ───
    // حقول لا يكتبها المستخدم بنفسه أبداً (تُدار بالأدمن/الخادم).
    function userProtectedKeys() {
      return ['role', 'uid', 'createdAt', 'email', 'isVerified', 'isBanned', 'banReason', 'bannedAt',
              'hasConfirmedReports', 'confirmedReportsCount', 'trustScore',
              'merchantVerified', 'verifiedAt', 'subscriptionTier'];
    }
    // حقول دفتر التقييم: تُكتب مرة عند كل تقييم جديد بقيم مقيّدة فقط.
    function userRatingKeys() { return ['publishedRatingsCount', 'userTrustFactor', 'lastRatedAt']; }

    // إنشاء مستند المستخدم: قيم ابتدائية ثابتة لا يستطيع العميل تضخيمها.
    function isValidNewUser(d) {
      return d.role in ['user', 'member']
          && d.get('uid', request.auth.uid) == request.auth.uid
          && d.get('isBanned', false) == false
          && d.get('publishedRatingsCount', 0) == 0
          && d.get('trustScore', 0) == 0
          && d.get('hasConfirmedReports', false) == false
          && d.get('confirmedReportsCount', 0) == 0
          && d.get('merchantVerified', false) == false
          && d.get('subscriptionTier', 'free') == 'free'
          && !('userTrustFactor' in d.keys());
    }

    // دفتر التقييم: زيادة العداد بمقدار 1 فقط ومعامل الثقة ضمن نطاق منطقي.
    function isRatingBookkeeping(oldD, newD) {
      let changed = newD.diff(oldD).affectedKeys();
      return changed.hasOnly(userRatingKeys())
          && (!changed.hasAny(['publishedRatingsCount'])
              || newD.publishedRatingsCount == oldD.get('publishedRatingsCount', 0) + 1)
          && (!changed.hasAny(['userTrustFactor'])
              || (newD.userTrustFactor is number && newD.userTrustFactor >= 0 && newD.userTrustFactor <= 2));
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin(); 
      
      allow create: if isSelf(userId) && isValidNewUser(request.resource.data);
      allow update: if isAdmin()
                    || (isSelf(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(userProtectedKeys().concat(userRatingKeys())))
                    || (isSelf(userId) && isRatingBookkeeping(resource.data, request.resource.data));
      // المحظور لا يحذف مستنده (يمنع التهرّب من الحظر بإعادة التسجيل).
      allow delete: if isAdmin() || (isSelf(userId) && resource.data.get('isBanned', false) == false);

      match /favorites/{placeId} { 
        allow read, create, delete: if isSelf(userId); 
        allow update: if false; 
      }
      match /notification_reads/{notificationId} { allow read, write: if isSelf(userId); }
      match /notification_hides/{notificationId} { allow read, write: if isSelf(userId); }
      match /fcm_tokens/{token} { allow read, write: if isSelf(userId); }
    }

    // ─── المفضلة (Favorites) ───
    match /favorites/{favoriteId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == uid(); 
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update: if false;
    }

    // ─── الأماكن (Places) ───
    match /places/{placeId} {
      allow get, list: if true;
      // إنشاء غير الأدمن: مكان غير معتمد وبعدادات صفرية فقط.
      allow create: if isAdmin() ||
                    (isSignedIn()
                      && request.resource.data.ownerId == uid()
                      && request.resource.data.get('isApproved', false) == false
                      && request.resource.data.get('averageRating', 0) == 0
                      && request.resource.data.get('reviewCount', 0) == 0
                      && request.resource.data.get('viewCount', 0) == 0);
      
      allow update: if isAdmin() || 
                    // عدّاد المشاهدات: مسجّل فقط وبزيادة 1 بالضبط.
                    (isSignedIn()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                      && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1) || 
                    // حقول التقييم المشتقة (مؤقتاً من العميل): نطاقات صالحة وخطوة عدد واحدة.
                    (isSignedIn() && isValidDerivedPlaceUpdate(resource.data, request.resource.data)) || 
                    (isMerchantOwner(placeId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'isApproved', 'averageRating', 'reviewCount', 'adjustedScore', 'sampleQuality', 'isRankable', 'createdAt', 'viewCount']));

      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.userId == uid() && isValidRating(request.resource.data.rating);
        allow update, delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      }
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if isModeratorOrAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isModeratorOrAdmin();
    }

    match /hides/{hideId} { 
      allow get: if isSignedIn() && resource.data.userId == uid(); 
      allow list: if isAdmin(); 
      allow write: if isSignedIn() && request.resource.data.userId == uid(); 
    }

    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }

    match /governorates/{governorateId} {
      allow read: if true;
      allow write: if isAdmin();
      match /districts/{districtId} { allow read: if true; allow write: if isAdmin(); }
    }

    // ─── الأحياء والمناطق (Districts / Zones) ───
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── المناطق (Zones) ───
    // حقول `notes` (string) و `geoZoneId` (string) مدعومة ضمنياً عبر
    // allow write: if isAdmin() — لا يوجد schema validation هنا
    // (لتجنّب كسر البيانات الحالية أثناء الهجرة التدريجية).
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /geo_zones/{zoneId} { allow read: if true; allow write: if isAdmin(); }
    match /filters/{filterId} { allow read: if true; allow write: if isModeratorOrAdmin(); }

    // ─── معايير التقييم (Review Criteria) ───
    // القراءة متاحة للجميع (لأن شاشة التقييم تحتاج جلب المعايير)
    // الكتابة (إضافة/تعديل/حذف) متاحة للأدمن فقط
    match /review_criteria/{criterionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // ★★★ NEW in v6.0 — Rating Pipeline Collections ★★★
    // ═══════════════════════════════════════════════════════════════

    // ─── الزيارات (Visits) ───
    // يُنشئها VisitService.createVisit() أثناء إرسال التقييم.
    // قراءة المالك/المشرف فقط (تحتوي إحداثيات GPS + deviceId).
    match /visits/{visitId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || isModeratorOrAdmin());
      allow list: if isSignedIn() && (resource.data.userId == uid() || isModeratorOrAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ─── التقييمات (Ratings) ───
    // قراءة:
    //   - أي زائر → التقييمات المنشورة فقط (status == 'PUBLISHED')
    //   - المالك → تقييماته (أي status)
    //   - المشرف/الأدمن → الكل
    // إنشاء: المستخدم المسجّل فقط، ولنفسه فقط.
    // تحديث:
    //   - المشرف/الأدمن → أي حقل
    //   - المستخدم → helpfulCount +1 أو reportCount +1 فقط (بدون لمس بقية الحقول)
    // حذف: الأدمن فقط.
    match /ratings/{ratingId} {
      allow get: if resource.data.status == 'PUBLISHED'
                  || (isSignedIn() && resource.data.userId == uid())
                  || isModeratorOrAdmin();
      allow list: if resource.data.status == 'PUBLISHED'
                   || (isSignedIn() && resource.data.userId == uid())
                   || isModeratorOrAdmin();
      // إنشاء: لنفسه، حالة منشور، عدّادات صفرية، وتقييم عام بين 1 و5.
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.status == 'PUBLISHED'
                    && request.resource.data.get('helpfulCount', 0) == 0
                    && request.resource.data.get('reportCount', 0) == 0
                    && isValidRating(request.resource.data.overall)
                    // تقييم واحد لكل مستخدم لكل مكان: المعرّف حتمي (uid_placeId).
                    && ratingId == request.resource.data.userId + '_' + request.resource.data.placeId
                    // حدود الحجم تمنع إغراق القاعدة بنصوص ضخمة.
                    && request.resource.data.get('body', '').size() <= 2000
                    && request.resource.data.get('title', '').size() <= 200
                    // لا تقييم لمكان تملكه (كان المنع في الواجهة فقط).
                    && get(/databases/$(database)/documents/places/$(request.resource.data.placeId)).data.get('ownerId', '') != uid();

      // helpfulCount +1 فقط (markHelpful)
      allow update: if isModeratorOrAdmin()
                    // ردّ التاجر مالك المكان: حقلا الردّ فقط، دون المساس بالتقييم.
                    || (isMerchantOwner(resource.data.placeId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['merchantReply', 'merchantRepliedAt']))
                    // تعديل المالك لتقييمه دون المساس بحقول الإشراف والهوية والعدّادات.
                    || (isSignedIn()
                        && resource.data.userId == uid()
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['userId', 'placeId', 'status', 'helpfulCount', 'reportCount',
                                       'createdAt', 'moderatedAt', 'moderatedBy', 'merchantReply', 'merchantRepliedAt'])
                        && isValidRating(request.resource.data.overall))
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])
                        && request.resource.data.helpfulCount == resource.data.helpfulCount + 1)
                    || (isSignedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                        && request.resource.data.reportCount == resource.data.reportCount + 1);

      allow delete: if isAdmin();
    }

    // ─── إحصاءات الأماكن (Place Aggregates) ───
    // يحدّثها AggregateService عبر transactions من جهة العميل.
    // قراءة عامة (تُعرض على بطاقة المكان). كتابة للمستخدمين المسجّلين فقط.
    // حذف: الأدمن فقط.
    match /place_aggregates/{placeId} {
      allow read: if true;
      // مؤقتاً من العميل: نطاقات صالحة وخطوة عدد واحدة (الحل الجذري في الخادم - P1).
      allow create, update: if isAdmin()
                            || (isSignedIn()
                                && request.resource.data.get('totalRatings', 0) is int
                                && request.resource.data.get('totalRatings', 0) >= 0
                                && request.resource.data.get('averageOverall', 0) is number
                                && request.resource.data.get('averageOverall', 0) >= 0
                                && request.resource.data.get('averageOverall', 0) <= 5
                                && (request.method == 'create'
                                    || (request.resource.data.get('totalRatings', 0) - resource.data.get('totalRatings', 0) <= 1
                                        && resource.data.get('totalRatings', 0) - request.resource.data.get('totalRatings', 0) <= 1)));
      allow delete: if isAdmin();
    }

    // ─── البلاغات (Reports) ───
    // يُنشئها RatingService.reportRating() — المستخدم المسجّل فقط لنفسه.
    // القراءة/التحديث/الحذف: المشرف/الأدمن فقط.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow get, list, update: if isModeratorOrAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    // (بقية القواعد — كما هي في v5.23)
    // ═══════════════════════════════════════════════════════════════

    match /merchant_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow list: if isAdmin(); 
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    match /offers/{offerId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (isAdmin() || isPlaceOwner(request.resource.data.placeId));
      allow update, delete: if isAdmin() || (isSignedIn() && isPlaceOwner(resource.data.placeId));
    }

    match /admin_stats/{docId} { allow read: if isModeratorOrAdmin(); allow write: if isAdmin(); }

    // ─── سجل التدقيق: إضافة فقط ───
    // التحديث مقصور على أعلام الأرشفة والحذف الناعم؛ لا حذف نهائي من أي دور.
    match /audit_logs/{logId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && request.resource.data.actorId == uid();
      allow update: if isModeratorOrAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['isArchived', 'archivedAt', 'isDeleted', 'deletedAt']);
      allow delete: if false;
    }

    // ─── سجل الإشراف: غير قابل للتعديل أو الحذف ───
    match /moderation_logs/{logId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && request.resource.data.actorId == uid();
      allow update, delete: if false;
    }

    // ─── أحداث النظام: إضافة فقط ───
    match /system_events/{eventId} {
      allow read: if isModeratorOrAdmin();
      allow create: if isModeratorOrAdmin() && request.resource.data.actorId == uid();
      allow update, delete: if false;
    }

    // ─── أرشيف تعديلات التقييم: يُنشئه صاحب التقييم، ولا يُعدَّل ───
    match /rating_revisions/{revisionId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isModeratorOrAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ─── طلبات استلام المكان (Owner Claims) ───
    match /owner_claim_requests/{claimId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || isModeratorOrAdmin());
      allow list: if isModeratorOrAdmin();
      allow create: if isSignedIn()
                    && request.resource.data.userId == uid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'userId', 'userDisplayName',
                         'userEmail', 'businessPhone', 'evidenceType', 'evidenceReference',
                         'evidenceImageUrls', 'notes', 'status', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    match /visit_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow list: if isAdmin(); 
      allow create: if isSignedIn() && request.resource.data.userId == uid();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    match /trip_plans/{planId} {
      allow create: if isSignedIn() && request.resource.data.userId == uid() && isValidTripStatus(request.resource.data.status)
                    && request.resource.data.stops.size() <= 50;
      allow get: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      // الاستعلام where(userId==uid) في TripRepository يتطلب قاعدة list تشمل المالك (كانت للأدمن فقط فيفشل لدى المستخدم العادي).
      allow list: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow update: if isSignedIn() && (resource.data.userId == uid() || isAdmin())
                    && request.resource.data.userId == resource.data.userId
                    && isValidTripStatus(request.resource.data.status)
                    && request.resource.data.stops.size() <= 50;
      allow delete: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
    }

    match /support_tickets/{ticketId} {
      allow create: if ((request.auth != null && request.resource.data.userId == request.auth.uid) || (request.auth == null && request.resource.data.userId == 'anonymous')) && request.resource.data.status == 'open'
                    // حدود الحجم تمنع إغراق التذاكر (الإنشاء متاح للزائر عمداً).
                    && request.resource.data.get('errorMessage', '').size() <= 2000
                    && request.resource.data.get('stackTrace', '').size() <= 4000;
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == uid());
      allow list: if isAdmin(); 
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (resource.data.userId == uid() || resource.data.userId == 'all');
      allow list: if isAdmin() || (isSignedIn() && (resource.data.userId == uid() || resource.data.userId == 'all')); 
      // الإنشاء للمشرف/الأدمن فقط (يمنع انتحال إشعارات لأي مستخدم أو للجميع).
      allow create: if isModeratorOrAdmin(); 
      allow update: if isSignedIn() && resource.data.userId == uid() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'title', 'body', 'type', 'createdAt']);
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    match /settings/{docId} { allow read: if true; allow write: if isAdmin(); }
    
    match /{document=**} { allow read, write: if false; }
  }
}